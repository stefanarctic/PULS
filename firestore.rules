rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isApprovedTeacher() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacherStatus == 'approved';
    }

    function classTeacherId(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId;
    }

    function isClassTeacher(classId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/classes/$(classId)) &&
             classTeacherId(classId) == request.auth.uid;
    }

    function isClassMember(classId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    function canReadClass(classId) {
      return isClassTeacher(classId) || isClassMember(classId);
    }

    function teacherStatusValidOnCreate() {
      return !('teacherStatus' in request.resource.data) ||
             request.resource.data.teacherStatus == 'none';
    }

    function teacherStatusOkForUser() {
      return !('teacherStatus' in request.resource.data) ||
             request.resource.data.teacherStatus == resource.data.teacherStatus ||
             (
               request.resource.data.teacherStatus == 'pending' &&
               resource.data.teacherStatus in ['none', 'rejected']
             ) ||
             (
               resource.data.teacherStatus == 'approved' &&
               request.resource.data.teacherStatus == 'approved'
             );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow read: if isAuthenticated();

      allow create: if isOwner(userId) &&
                       (!('isAdmin' in request.resource.data) ||
                        request.resource.data.isAdmin == false) &&
                       teacherStatusValidOnCreate() &&
                       'email' in request.resource.data &&
                       'name' in request.resource.data &&
                       'joinedDate' in request.resource.data;

      allow update: if isOwner(userId) &&
                       (!('isAdmin' in request.resource.data) ||
                        request.resource.data.isAdmin == resource.data.isAdmin) &&
                       (!('email' in request.resource.data) ||
                        request.resource.data.email == resource.data.email) &&
                       (!('joinedDate' in request.resource.data) ||
                        request.resource.data.joinedDate == resource.data.joinedDate) &&
                       teacherStatusOkForUser();

      allow update: if isAdmin();

      allow delete: if isAdmin();

      match /userProblems/{problemId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }

      match /chats/{chatId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /classJoinCodes/{joinCode} {
      allow read: if isAuthenticated();
      // Clasa trebuie să existe deja; get() vede documentul după setDoc (scriere secvențială, nu în aceeași tranzacție cu codul).
      allow create: if isApprovedTeacher() &&
                       request.resource.data.keys().hasOnly(['classId']) &&
                       get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId == request.auth.uid;
      allow delete: if isApprovedTeacher() &&
                       exists(/databases/$(database)/documents/classJoinCodes/$(joinCode)) &&
                       classTeacherId(get(/databases/$(database)/documents/classJoinCodes/$(joinCode)).data.classId) == request.auth.uid;
    }

    match /classes/{classId} {
      allow read: if canReadClass(classId);

      allow create: if isApprovedTeacher() &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['teacherId', 'name', 'joinCode', 'createdAt']) &&
                       request.resource.data.name is string &&
                       request.resource.data.joinCode is string &&
                       request.resource.data.joinCode.size() >= 4 &&
                       request.resource.data.joinCode.size() <= 32;

      allow update: if isClassTeacher(classId) &&
                       request.resource.data.teacherId == resource.data.teacherId;

      allow delete: if isClassTeacher(classId);

      match /members/{studentUid} {
        allow read: if isClassTeacher(classId) || isOwner(studentUid);

        allow create: if isAuthenticated() &&
                         request.auth.uid == studentUid &&
                         request.resource.data.studentUid == studentUid &&
                         exists(/databases/$(database)/documents/classJoinCodes/$(request.resource.data.joinCode)) &&
                         get(/databases/$(database)/documents/classJoinCodes/$(request.resource.data.joinCode)).data.classId == classId &&
                         request.resource.data.keys().hasAll(['joinedAt', 'joinCode', 'studentUid']) &&
                         request.resource.data.joinedAt is timestamp;

        allow update: if isAuthenticated() && request.auth.uid == studentUid &&
                         request.resource.data.studentUid == studentUid &&
                         request.resource.data.keys().hasOnly(['joinedAt', 'studentName', 'studentUid']) &&
                         !('joinCode' in request.resource.data) &&
                         resource.data.keys().hasAny(['joinCode']);

        allow delete: if isClassTeacher(classId) || (isAuthenticated() && request.auth.uid == studentUid);
      }

      match /assignments/{assignmentId} {
        allow read: if canReadClass(classId);

        allow create: if isClassTeacher(classId) &&
                         request.resource.data.teacherId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['title', 'createdAt', 'teacherId', 'items']) &&
                         request.resource.data.title is string &&
                         request.resource.data.items is list;

        allow update: if isClassTeacher(classId) &&
                         request.resource.data.teacherId == resource.data.teacherId;

        allow delete: if isClassTeacher(classId);
      }
    }

    match /problems/{problemId} {
      allow read: if true;

      allow create: if isAdmin() &&
                       'titlu' in request.resource.data &&
                       'categorie' in request.resource.data &&
                       'continut' in request.resource.data &&
                       (request.resource.data.categorie == 'Bac' ||
                        'dificultate' in request.resource.data);

      allow update, delete: if isAdmin();
    }

    match /grile/{grilaId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

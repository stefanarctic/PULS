rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isApprovedTeacher() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacherStatus == 'approved';
    }

    function classTeacherId(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId;
    }

    function isClassTeacher(classId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/classes/$(classId)) &&
             classTeacherId(classId) == request.auth.uid;
    }

    function userJoinedClass(classId) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return 'joinedClasses' in u && u.joinedClasses is list &&
             u.joinedClasses.hasAny([classId]);
    }

    function canReadClass(classId) {
      return isClassTeacher(classId) || userJoinedClass(classId) || isAdmin();
    }

    function teacherStatusValidOnCreate() {
      return !('teacherStatus' in request.resource.data) ||
             request.resource.data.teacherStatus == 'none';
    }

    function teacherStatusOkForUser() {
      return !('teacherStatus' in request.resource.data) ||
             request.resource.data.teacherStatus == resource.data.teacherStatus ||
             (
               request.resource.data.teacherStatus == 'pending' &&
               resource.data.teacherStatus in ['none', 'rejected']
             ) ||
             (
               resource.data.teacherStatus == 'approved' &&
               request.resource.data.teacherStatus == 'approved'
             );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow read: if isAuthenticated();

      allow create: if isOwner(userId) &&
                       (!('isAdmin' in request.resource.data) ||
                        request.resource.data.isAdmin == false) &&
                       teacherStatusValidOnCreate() &&
                       'email' in request.resource.data &&
                       'name' in request.resource.data &&
                       'joinedDate' in request.resource.data;

      allow update: if isOwner(userId) &&
                       (!('isAdmin' in request.resource.data) ||
                        request.resource.data.isAdmin == resource.data.isAdmin) &&
                       (!('email' in request.resource.data) ||
                        request.resource.data.email == resource.data.email) &&
                       (!('joinedDate' in request.resource.data) ||
                        request.resource.data.joinedDate == resource.data.joinedDate) &&
                       teacherStatusOkForUser();

      allow update: if isAdmin();

      allow update: if isApprovedTeacher() && request.auth.uid != userId &&
                       request.resource.data.diff(resource.data).changedKeys().hasOnly(['joinedClasses']) &&
                       resource.data.joinedClasses is list &&
                       request.resource.data.joinedClasses is list &&
                       resource.data.joinedClasses.size() == request.resource.data.joinedClasses.size() + 1;

      allow delete: if isAdmin();

      match /userProblems/{problemId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }

      match /chats/{chatId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /classes/{classId} {
      // Citire metadata clasă: profesor, membri, admin — sau orice user autentificat care știe ID-ul (pentru înscriere cu cod).
      // Temele rămân în subcolecția assignments, doar pentru membri.
      allow read: if canReadClass(classId) || isAuthenticated();

      allow create: if isApprovedTeacher() &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['teacherId', 'name', 'createdAt']) &&
                       request.resource.data.name is string &&
                       !('joinCode' in request.resource.data);

      allow update: if isClassTeacher(classId) &&
                       request.resource.data.teacherId == resource.data.teacherId;

      allow delete: if isClassTeacher(classId) || isAdmin();

      match /assignments/{assignmentId} {
        allow read: if canReadClass(classId);

        allow create: if isClassTeacher(classId) &&
                         request.resource.data.teacherId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['title', 'createdAt', 'teacherId', 'items']) &&
                         request.resource.data.title is string &&
                         request.resource.data.items is list;

        allow update: if isClassTeacher(classId) &&
                         request.resource.data.teacherId == resource.data.teacherId;

        allow delete: if isClassTeacher(classId) || isAdmin();

        match /submissions/{studentUid} {
          allow read: if canReadClass(classId);
          allow create: if isAuthenticated() && request.auth.uid == studentUid &&
                           request.resource.data.keys().hasAll(['studentUid', 'updatedAt']) &&
                           request.resource.data.studentUid == studentUid;
          allow update: if isAuthenticated() && request.auth.uid == studentUid &&
                           resource.data.studentUid == studentUid &&
                           request.resource.data.studentUid == studentUid;
          allow delete: if isClassTeacher(classId) || isAdmin();
        }
      }
    }

    match /problems/{problemId} {
      allow read: if true;

      allow create: if isAdmin() &&
                       'titlu' in request.resource.data &&
                       'categorie' in request.resource.data &&
                       'continut' in request.resource.data &&
                       (request.resource.data.categorie == 'Bac' ||
                        'dificultate' in request.resource.data);

      allow update, delete: if isAdmin();
    }

    match /grile/{grilaId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
